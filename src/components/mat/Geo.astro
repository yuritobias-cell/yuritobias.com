---
/* Figura de geometria plana desenhada no build — o `tikzpicture` das listas de
   triângulos, relações métricas e trigonometria. Funciona como o TikZ: você dá
   os pontos com coordenadas (y para cima) e declara o que desenhar.

     <Geo pontos={{ A: [9, 12], B: [0, 0], C: [25, 0], H: [9, 0] }}
          poligonos={[['A', 'B', 'C']]}
          segmentos={[['A', 'H']]}
          nomes={['A', 'B', 'C', 'H']}
          medidas={[{ de: 'A', para: 'B', texto: 'c' }, { de: 'A', para: 'H', texto: 'h', lado: -1 }]}
          retos={[['B', 'A', 'C'], ['A', 'H', 'C']]}
          angulos={[{ v: 'C', de: 'B', para: 'A', texto: 'α' }]}
          cotas={[{ de: 'B', para: 'C', texto: 'a' }]}
          solo={['P', 'Q']}
          descricao="…" />

   Onde se pede um ponto, vale o nome ('A') ou a coordenada ([3, 4]).

   - medidas: texto no meio do segmento, do lado de fora da figura. Em segmento
     interno (a altura de um triângulo), `lado: 1 | -1` escolhe o lado.
   - retos: [P, V, Q] marca o ângulo reto em V (o quadradinho).
   - angulos: arco em `v`, de `de` até `para` (o menor ângulo), com o texto na
     bissetriz.
   - cotas: linha de cota afastada da figura, com o texto — a medida total
     de um lado que já tem medidas parciais (o "a" sob o "9 | 16").
   - solo: o chão hachurado, sob o segmento dado.
   - setas: [de, para] — raios de sol, forças, o que precisar de seta.

   As figuras guardam a proporção das coordenadas; `tamanho` é a maior dimensão
   em px. Letra sozinha (nome de ponto, medida "c") vai em itálico.
   `descricao` é obrigatória: é o que o leitor de tela diz no lugar da figura. */
type Ref = string | [number, number];
interface Props {
  pontos?: Record<string, [number, number]>;
  poligonos?: Ref[][];
  segmentos?: [Ref, Ref][];
  tracejados?: [Ref, Ref][];
  nomes?: string[];
  /** `dist` (px, padrão 10) afasta mais o texto — abaixo de um chão hachurado, por exemplo. */
  medidas?: { de: Ref; para: Ref; texto: string; lado?: 1 | -1; dist?: number }[];
  retos?: [Ref, Ref, Ref][];
  angulos?: { v: Ref; de: Ref; para: Ref; texto?: string; raio?: number }[];
  cotas?: { de: Ref; para: Ref; texto: string; dist?: number }[];
  solo?: [Ref, Ref];
  setas?: [Ref, Ref][];
  /** Regiões com curvas — ver "Regiões" no topo do arquivo. */
  regioes?: Regiao[];
  /** Pontinhos cheios (o centro O de uma circunferência). */
  marcas?: Ref[];
  /** Marcas de congruência: tracinhos no meio do segmento (n = quantos, padrão 1). */
  iguais?: [Ref, Ref, number?][];
  /** Texto solto, centrado no ponto dado — a medida de um arco, fora da circunferência. */
  textos?: { em: Ref; texto: string }[];
  tamanho?: number;
  rotulo?: string;
  descricao: string;
}

/* Regiões: um caminho em coordenadas da figura, passo a passo —
     ['M', p]                 vai para p
     ['L', p]                 reta até p
     ['A', centro, p, 'ah']   arco em torno de `centro` até p, no sentido
                              anti-horário ('ah') ou horário ('h'); o raio é a
                              distância do ponto atual ao centro
     ['O', centro, raio]      circunferência inteira (um sub-caminho só dela)
     ['Z']                    fecha
   `pintado` preenche (regra par-ímpar: um círculo dentro de outro vira coroa,
   um círculo dentro do quadrado vira as "pontas"); `contorno` é true, false,
   'tracejado' ou 'realce' (o arco grosso e colorido de "arco AB = 70°"). */
type Passo = ['M', Ref] | ['L', Ref] | ['A', Ref, Ref, 'h' | 'ah'] | ['O', Ref, number] | ['Z'];
interface Regiao {
  d: Passo[];
  pintado?: boolean;
  contorno?: boolean | 'tracejado' | 'realce';
}

const {
  pontos = {}, poligonos = [], segmentos = [], tracejados = [], nomes = [],
  medidas = [], retos = [], angulos = [], cotas = [], solo, setas = [],
  regioes = [], marcas = [], iguais = [], textos: soltos = [],
  tamanho = 200, rotulo, descricao,
} = Astro.props;

type P = [number, number];
const ponto = (r: Ref): P => {
  if (Array.isArray(r)) return r;
  const p = pontos[r];
  if (!p) throw new Error(`[Geo] ponto "${r}" não existe em pontos={{ ${Object.keys(pontos).join(', ')} }}`);
  return p;
};

/* Regiões, primeiro no espaço da figura: amostras das curvas (para a caixa do
   desenho) e uma função que escreve o `d` do SVG quando a escala existir. */
const TAU = 2 * Math.PI;
const giro = (a: number) => ((a % TAU) + TAU) % TAU;
const caminhos = regioes.map(({ d }) => {
  const amostras: P[] = [];
  let atual: P = [0, 0];
  type Op = (T: (r: Ref) => P, s: number) => string;
  const ops: Op[] = [];
  for (const passo of d) {
    if (passo[0] === 'M' || passo[0] === 'L') {
      const p = ponto(passo[1]); atual = p; amostras.push(p);
      const letra = passo[0];
      ops.push((T) => `${letra}${T(p).map((v) => v.toFixed(1)).join(',')}`);
    } else if (passo[0] === 'A') {
      const c = ponto(passo[1]), fim = ponto(passo[2]), anti = passo[3] === 'ah';
      const r = Math.hypot(atual[0] - c[0], atual[1] - c[1]);
      const a0 = Math.atan2(atual[1] - c[1], atual[0] - c[0]);
      const a1 = Math.atan2(fim[1] - c[1], fim[0] - c[0]);
      const varre = anti ? giro(a1 - a0) || TAU : giro(a0 - a1) || TAU;
      for (let k = 1; k <= 16; k++) {
        const a = a0 + (anti ? 1 : -1) * varre * (k / 16);
        amostras.push([c[0] + r * Math.cos(a), c[1] + r * Math.sin(a)]);
      }
      atual = fim;
      // Com y para baixo na tela, anti-horário da matemática é sweep 0 no SVG.
      ops.push((T, s) => `A${(r * s).toFixed(1)},${(r * s).toFixed(1)} 0 ${varre > Math.PI ? 1 : 0} ${anti ? 0 : 1} ${T(fim).map((v) => v.toFixed(1)).join(',')}`);
    } else if (passo[0] === 'O') {
      const c = ponto(passo[1]), r = passo[2];
      amostras.push([c[0] - r, c[1] - r], [c[0] + r, c[1] + r]);
      ops.push((T, s) => {
        const [x, y] = T(c), R = (r * s).toFixed(1);
        return `M${(x + r * s).toFixed(1)},${y.toFixed(1)} A${R},${R} 0 1 0 ${(x - r * s).toFixed(1)},${y.toFixed(1)} A${R},${R} 0 1 0 ${(x + r * s).toFixed(1)},${y.toFixed(1)} Z`;
      });
    } else {
      ops.push(() => 'Z');
    }
  }
  return { amostras, escreve: (T: (r: Ref) => P, s: number) => ops.map((op) => op(T, s)).join(' ') };
});

// Escala: a maior dimensão do que foi desenhado vira `tamanho` px.
const todos: P[] = [
  ...Object.values(pontos),
  ...poligonos.flat().map(ponto), ...segmentos.flat().map(ponto), ...setas.flat().map(ponto),
  ...caminhos.flatMap((c) => c.amostras),
];
const xs = todos.map((p) => p[0]), ys = todos.map((p) => p[1]);
const [x0, x1, y0, y1] = [Math.min(...xs), Math.max(...xs), Math.min(...ys), Math.max(...ys)];
const s = tamanho / Math.max(x1 - x0, y1 - y0, 1e-9);
const T = (r: Ref): P => { const [x, y] = ponto(r); return [(x - x0) * s, (y1 - y) * s]; };

// Centro da figura (em tela): os rótulos fogem dele. É o baricentro dos
// vértices dos polígonos — o centro da caixa não serve: num triângulo
// retângulo ele cai em cima da hipotenusa, e "fora" fica indefinido.
// Sem polígono, valem os pontos nomeados mais as curvas — só os pontos não
// bastam: em A, C, O, D, B sobre um diâmetro, o centro cairia em cima da reta
// e os nomes não teriam para onde fugir.
const base: P[] = poligonos.length ? poligonos.flat().map(T)
  : [...Object.keys(pontos), ...caminhos.flatMap((c) => c.amostras)].map(T);
const cx = base.reduce((a, p) => a + p[0], 0) / base.length;
const cy = base.reduce((a, p) => a + p[1], 0) / base.length;
const unit = (dx: number, dy: number): P => { const L = Math.hypot(dx, dy) || 1; return [dx / L, dy / L]; };
const ancora = (dx: number) => (dx > 0.35 ? 'start' : dx < -0.35 ? 'end' : 'middle');
const ehLetra = (t: string) => /^[A-Za-zα-ωΑ-Ω]('|′)?$/.test(t);

/* Texto: letra sozinha vai inteira em itálico; num texto maior, o que estiver
   entre asteriscos vira itálico — "3*x* + 10°" escreve 3x + 10° com o x
   inclinado, sem pôr "cm" em itálico junto. */
type Parte = { t: string; it: boolean };
type Txt = { x: number; y: number; partes: Parte[]; a: string };
const textos: Txt[] = [];
const partes = (t: string): Parte[] => ehLetra(t)
  ? [{ t, it: true }]
  : t.split('*').map((pedaco, i) => ({ t: pedaco, it: i % 2 === 1 })).filter((p) => p.t);
const escreve = (x: number, y: number, t: string, dx: number) =>
  textos.push({ x, y: y + 4, partes: partes(t), a: ancora(dx) });

// Nomes dos pontos: empurrados para fora do centro.
for (const n of nomes) {
  const [x, y] = T(n);
  const [ux, uy] = unit(x - cx, y - cy);
  escreve(x + ux * 11, y + uy * 11, n, ux);
}

// Medidas: na normal do segmento, do lado oposto ao centro (ou o lado pedido).
for (const { de, para, texto, lado, dist = 10 } of medidas) {
  const [ax, ay] = T(de), [bx, by] = T(para);
  const [mx, my] = [(ax + bx) / 2, (ay + by) / 2];
  let [nx, ny] = unit(-(by - ay), bx - ax);
  if (lado) { nx *= lado; ny *= lado; }
  else if (nx * (mx - cx) + ny * (my - cy) < 0) { nx = -nx; ny = -ny; }
  escreve(mx + nx * dist, my + ny * dist, texto, nx);
}

for (const { em, texto } of soltos) {
  const [x, y] = T(em);
  escreve(x, y, texto, 0);
}

// Congruência: n tracinhos perpendiculares, no meio do segmento.
const tracinhos = iguais.map(([a, b, n = 1]) => {
  const [ax, ay] = T(a), [bx, by] = T(b);
  const [ux, uy] = unit(bx - ax, by - ay);
  const [mx, my] = [(ax + bx) / 2, (ay + by) / 2];
  let d = '';
  for (let k = 0; k < n; k++) {
    const desl = (k - (n - 1) / 2) * 3.5;
    const [px, py] = [mx + ux * desl, my + uy * desl];
    // inclinado, como o // dos livros
    d += `M${(px - uy * 5 - ux * 2).toFixed(1)},${(py + ux * 5 - uy * 2).toFixed(1)} L${(px + uy * 5 + ux * 2).toFixed(1)},${(py - ux * 5 + uy * 2).toFixed(1)} `;
  }
  return d;
});

// Ângulo reto: o quadradinho no vértice do meio.
const quadrados = retos.map(([p, v, q]) => {
  const V = T(v), [ux, uy] = unit(T(p)[0] - V[0], T(p)[1] - V[1]), [wx, wy] = unit(T(q)[0] - V[0], T(q)[1] - V[1]);
  const k = 8;
  return `${V[0] + ux * k},${V[1] + uy * k} ${V[0] + (ux + wx) * k},${V[1] + (uy + wy) * k} ${V[0] + wx * k},${V[1] + wy * k}`;
});

// Arcos: do raio V→de ao raio V→para, pelo menor ângulo.
const arcos = angulos.map(({ v, de, para, texto, raio = 20 }) => {
  const V = T(v);
  const a1 = Math.atan2(T(de)[1] - V[1], T(de)[0] - V[0]);
  const a2 = Math.atan2(T(para)[1] - V[1], T(para)[0] - V[0]);
  let d = a2 - a1;
  while (d > Math.PI) d -= 2 * Math.PI;
  while (d < -Math.PI) d += 2 * Math.PI;
  const p1: P = [V[0] + raio * Math.cos(a1), V[1] + raio * Math.sin(a1)];
  const p2: P = [V[0] + raio * Math.cos(a1 + d), V[1] + raio * Math.sin(a1 + d)];
  const meio = a1 + d / 2;
  if (texto) {
    const r = raio + 11;
    // O texto cresce para o lado da bissetriz (para fora do vértice), assim um
    // rótulo comprido como "3x + 10°" não atravessa os lados do ângulo.
    escreve(V[0] + r * Math.cos(meio), V[1] + r * Math.sin(meio), texto, Math.cos(meio));
  }
  return `M${p1[0].toFixed(1)},${p1[1].toFixed(1)} A${raio},${raio} 0 0 ${d > 0 ? 1 : 0} ${p2[0].toFixed(1)},${p2[1].toFixed(1)}`;
});

// Cotas: paralelas ao segmento, afastadas para fora, com tracinhos nas pontas.
const linhasCota = cotas.map(({ de, para, texto, dist = 26 }) => {
  const [ax, ay] = T(de), [bx, by] = T(para);
  let [nx, ny] = unit(-(by - ay), bx - ax);
  if (nx * ((ax + bx) / 2 - cx) + ny * ((ay + by) / 2 - cy) < 0) { nx = -nx; ny = -ny; }
  const [px1, py1, px2, py2] = [ax + nx * dist, ay + ny * dist, bx + nx * dist, by + ny * dist];
  escreve((px1 + px2) / 2 + nx * 11, (py1 + py2) / 2 + ny * 11, texto, nx);
  const t = 4;
  return [
    `M${px1},${py1} L${px2},${py2}`,
    `M${px1 - nx * t},${py1 - ny * t} L${px1 + nx * t},${py1 + ny * t}`,
    `M${px2 - nx * t},${py2 - ny * t} L${px2 + nx * t},${py2 + ny * t}`,
  ].join(' ');
});

// Chão hachurado: a linha um pouco além do segmento e os riscos por baixo.
let chao = '';
if (solo) {
  const [ax, ay] = T(solo[0]), [bx, by] = T(solo[1]);
  const [ux, uy] = unit(bx - ax, by - ay);
  const [sx, sy, ex, ey] = [ax - ux * 10, ay - uy * 10, bx + ux * 10, by + uy * 10];
  const L = Math.hypot(ex - sx, ey - sy);
  let d = `M${sx},${sy} L${ex},${ey}`;
  for (let k = 6; k < L; k += 7) {
    const [hx, hy] = [sx + ux * k, sy + uy * k];
    d += ` M${hx},${hy} L${hx - 5},${hy + 6}`;
  }
  chao = d;
}

const pts = (q: P[]) => q.map(([x, y]) => `${x.toFixed(1)},${y.toFixed(1)}`).join(' ');
const linha = ([a, b]: [Ref, Ref]) => { const [p, q] = [T(a), T(b)]; return { x1: p[0], y1: p[1], x2: q[0], y2: q[1] }; };

// Caixa do desenho: a figura mais folga para rótulos, cotas e chão.
const M = 30;
const baixo = cotas.length ? Math.max(...cotas.map((c) => c.dist ?? 26)) + 24 : 0;
const vb = [-M, -M, (x1 - x0) * s + 2 * M, (y1 - y0) * s + 2 * M + Math.max(baixo - M + 10, 0)];

let h = 0;
for (const ch of descricao) h = (h * 31 + ch.charCodeAt(0)) >>> 0;
const id = `geo-${h.toString(36)}`;
---
<figure class="geo">
  <svg viewBox={vb.map((v) => v.toFixed(1)).join(' ')} width={Math.round(vb[2])} role="img" aria-label={descricao}>
    <defs>
      <marker id={id} viewBox="0 0 8 8" refX="7" refY="4" markerWidth="6" markerHeight="6" orient="auto">
        <path d="M0,0 L8,4 L0,8 z" fill="currentColor" />
      </marker>
    </defs>
    {chao && <path class="chao" d={chao} />}
    {regioes.map((r, i) => r.pintado && <path class="pinta" d={caminhos[i].escreve(T, s)} />)}
    {poligonos.map((pg) => <polygon points={pts(pg.map(T))} />)}
    {regioes.map((r, i) => (r.contorno ?? true) && (
      <path class:list={[{ esc: r.contorno === 'tracejado', realce: r.contorno === 'realce' }]} d={caminhos[i].escreve(T, s)} />
    ))}
    {marcas.map((m) => <circle class="marca" cx={T(m)[0]} cy={T(m)[1]} r="2.2" />)}
    {segmentos.map((sg) => <line {...linha(sg)} />)}
    {tracejados.map((sg) => <line class="esc" {...linha(sg)} />)}
    {setas.map((sg) => <line class="fino" {...linha(sg)} marker-end={`url(#${id})`} />)}
    {quadrados.map((q) => <polyline class="fino" points={q} />)}
    {tracinhos.map((d) => <path class="fino" d={d} />)}
    {arcos.map((d) => <path class="fino" d={d} />)}
    {linhasCota.map((d) => <path class="fino" d={d} />)}
    {textos.map((t) => (
      <text x={t.x.toFixed(1)} y={t.y.toFixed(1)} text-anchor={t.a}>
        {t.partes.map((p) => <tspan font-style={p.it ? 'italic' : 'normal'}>{p.t}</tspan>)}
      </text>
    ))}
  </svg>
  {rotulo && <figcaption set:html={rotulo} />}
</figure>

<style>
  .geo { display: inline-block; margin: 0.5rem 0; text-align: center; vertical-align: top; }
  .geo svg { max-width: 100%; height: auto; color: var(--ink); overflow: visible; }
  polygon, line, path, polyline { fill: none; stroke: currentColor; stroke-width: 1.3; stroke-linejoin: round; }
  .fino { stroke-width: 0.9; }
  .esc { stroke-dasharray: 4 3; stroke-width: 1; }
  .chao { stroke-width: 0.9; }
  .pinta { fill: color-mix(in srgb, var(--accent) 16%, transparent); fill-rule: evenodd; stroke: none; }
  .realce { stroke: var(--accent); stroke-width: 2.6; }
  .marca { fill: currentColor; stroke: none; }
  text {
    font-family: var(--mat); font-size: 12.5px; fill: currentColor;
    paint-order: stroke; stroke: var(--bg); stroke-width: 3.5px; stroke-linejoin: round;
  }
  figcaption { font-size: 0.85rem; font-weight: 600; margin-top: 0.1rem; }
</style>
