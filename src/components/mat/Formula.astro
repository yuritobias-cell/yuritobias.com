---
/* Fórmula na própria linha — o `\mbox{$...$}` e o `$$...$$` das listas, que
   existem para a expressão não quebrar no meio. `centro` é o display math. */
interface Props {
  centro?: boolean;
}
const { centro = false } = Astro.props;
---
<!-- div, e não p: em bloco multilinha o MDX envolve o conteúdo num parágrafo,
     e parágrafo dentro de parágrafo é HTML inválido — o navegador separa os dois
     e a fórmula sai vazia. -->
<div class:list={['formula', { centro }]}><slot /></div>

<style>
  .formula {
    font-family: var(--mat);
    line-height: 1.7;
    font-size: 1.05rem;
    margin: 0.5rem 0 0.7rem;
    padding-left: 0.1rem;
  }
  .centro { text-align: center; font-size: 1.15rem; margin: 0.9rem 0; }
  .formula :global(p) { margin: 0; }
</style>
