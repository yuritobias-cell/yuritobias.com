---
/* Listas em HTML das séries ativas: /materiais/<slug>/<id>.
   Depois da virada, as listas da série arquivada passam a viver em
   /materiais/arquivo/<ano>/<slug>/<id>, e o endereço antigo — que pode estar
   num QR Code ou no grupo da turma, com o #q3 da questão — vira um desvio para
   lá, a menos que uma lista do ano novo tenha ocupado o mesmo endereço. */
import PaginaLista from '../../../components/PaginaLista.astro';
import { listasPublicadas, listasDesviadas, serieDaLista, type Lista } from '../../../utils/listas';

export async function getStaticPaths() {
  const ativas = (await listasPublicadas()).filter((l) => !serieDaLista(l).arquivada);
  const desvios = await listasDesviadas();
  return [
    ...ativas.map((lista) => ({
      params: { serie: lista.data.serie, lista: lista.id },
      props: { lista, destino: undefined },
    })),
    ...desvios.map((d) => ({
      params: { serie: d.slug, lista: d.id },
      props: { lista: undefined, destino: d.destino },
    })),
  ];
}

type Props = { lista: Lista; destino: undefined } | { lista: undefined; destino: string };
const { lista, destino } = Astro.props;
const destinoAbsoluto = destino && new URL(`${destino}/`, Astro.site).toString();
---

{lista && <PaginaLista lista={lista} />}
{destinoAbsoluto && (
  <html lang="pt-BR">
    <head>
      <meta charset="utf-8" />
      <title>Lista arquivada</title>
      <meta name="robots" content="noindex" />
      <link rel="canonical" href={destinoAbsoluto} />
      {/* O script leva junto o #q3; o meta refresh é a rede para quem está sem JS. */}
      <script is:inline define:vars={{ destino: `${destino}/` }}>location.replace(destino + location.hash);</script>
      <meta http-equiv="refresh" content={`0;url=${destino}/`} />
    </head>
    <body>
      <p>Esta lista foi arquivada: <a href={`${destino}/`}>{destinoAbsoluto}</a></p>
    </body>
  </html>
)}
