---
/* A porta do site. Quem chega em yuritobias.com tem de ver o que existe aqui —
   as últimas listas publicadas, as ferramentas e a análise mais recente —, e não
   só um cartão de visita. A biografia completa mora em /sobre.
   Nada nesta página é catalogado à mão: tudo sai dos mesmos manifestos que
   dirigem /materiais, /ferramentas e /analises. */
import Layout from '../layouts/Layout.astro';
import { materiaisRecentes, urlSerie, series } from '../utils/materiais';
import { mapaDeListas, listaDe, urlLista } from '../utils/listas';
import { destaques, ferramentas } from '../utils/ferramentas';
import { analisesPublicadas, dataPorExtenso } from '../utils/analises';

const nomeCompleto = 'Yuri Tobias Aquiel Correa Ramos';
const site = Astro.site?.toString();
const descricao =
  'Materiais didáticos de matemática para o 9º ano e o Ensino Médio, ferramentas '
  + 'interativas para sala de aula e análises de dados educacionais. '
  + 'Yuri Tobias — professor e analista de dados em Poços de Caldas (MG).';

// Os últimos publicados: quem tem versão em HTML é levado a ela, e não ao PDF.
const listas = await mapaDeListas();
const recentes = materiaisRecentes(4).map((r) => {
  const lista = listaDe(listas, r.serie, r.material);
  return {
    ...r,
    url: lista ? urlLista(lista) : urlSerie(r.serie),
    online: Boolean(lista),
  };
});

const vitrine = destaques.slice(0, 3);
const ultimaAnalise = analisesPublicadas[0];

const totalMateriais = series
  .filter((s) => !s.arquivada)
  .reduce((n, s) => n + s.materiais.length + s.provas.length + s.formativas.length, 0);

// "18 set" — o pt-BR devolve "18 de set." e o "de" não cabe na coluna da data.
const dataCurta = (iso: string) => {
  const d = new Date(`${iso}T00:00:00Z`);
  const dia = d.toLocaleDateString('pt-BR', { day: '2-digit', timeZone: 'UTC' });
  const mes = d.toLocaleDateString('pt-BR', { month: 'short', timeZone: 'UTC' }).replace('.', '');
  return `${dia} ${mes}`;
};

/* O Person continua aqui, e não só em /sobre: é a home que responde por buscas
   pelo nome de registro. A ficha completa fica na página de perfil. */
const pessoa = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': 'https://yuritobias.com/#eu',
  name: 'Yuri Tobias',
  alternateName: nomeCompleto,
  url: site,
  mainEntityOfPage: new URL('/sobre', Astro.site).toString(),
  jobTitle: ['Professor de Matemática', 'Analista de Dados Educacionais'],
  sameAs: [
    'https://www.linkedin.com/in/yuri-tobias-aquiel-correa-ramos-754184104/',
    'https://lattes.cnpq.br/2782196498099761',
    'https://github.com/yuritobias-cell',
  ],
};

const website = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': 'https://yuritobias.com/#site',
  url: site,
  name: 'Yuri Tobias',
  alternateName: nomeCompleto,
  description: descricao,
  inLanguage: 'pt-BR',
  author: { '@id': 'https://yuritobias.com/#eu' },
  publisher: { '@id': 'https://yuritobias.com/#eu' },
  potentialAction: {
    '@type': 'SearchAction',
    target: {
      '@type': 'EntryPoint',
      urlTemplate: 'https://yuritobias.com/busca?q={search_term_string}',
    },
    'query-input': 'required name=search_term_string',
  },
};
---

<Layout
  title="Yuri Tobias — Matemática, materiais e dados educacionais"
  description={descricao}
  schema={[pessoa, website]}
>
  <main>
    <header class="capa">
      <h1>Yuri Tobias</h1>
      <p class="papeis">
        Professor de Matemática
        <span class="sep">·</span>
        Analista de Dados Educacionais
      </p>
      <p class="linha">
        Materiais didáticos para o 9º ano e o Ensino Médio, ferramentas para usar
        em sala e análises de dados educacionais — tudo aberto, sem cadastro e
        livre para adaptar na sua escola.
      </p>
      <div class="acoes">
        <a href="/materiais" class="btn">Ver materiais</a>
        <a href="/ferramentas" class="btn sec">Ver ferramentas</a>
      </div>
    </header>

    <section class="bloco">
      <div class="bloco-topo">
        <h2>Publicados recentemente</h2>
        <a href="/materiais" class="mais">Todos os {totalMateriais} materiais →</a>
      </div>
      <ul class="recentes">
        {recentes.map((r) => (
          <li>
            <a href={r.url}>
              <span class="data"><time datetime={r.material.data}>{dataCurta(r.material.data)}</time></span>
              <span class="corpo">
                <span class="titulo">{r.material.titulo}</span>
                <span class="meta">{r.serie.titulo} · {r.categoria}{r.online && <span class="tag-online">Ler online</span>}</span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <section class="bloco">
      <div class="bloco-topo">
        <h2>Ferramentas</h2>
        <a href="/ferramentas" class="mais">As {ferramentas.length} ferramentas →</a>
      </div>
      <div class="vitrine">
        {vitrine.map((f) => (
          <a href={`/ferramentas/${f.slug}`} class="card">
            <span class="card-tag">{f.assunto}</span>
            <span class="card-titulo">{f.titulo}</span>
            <span class="card-desc">{f.descricao}</span>
          </a>
        ))}
      </div>
    </section>

    {ultimaAnalise && (
      <section class="bloco">
        <div class="bloco-topo">
          <h2>Última análise</h2>
          <a href="/analises" class="mais">Todas as análises →</a>
        </div>
        <a href={`/analises/${ultimaAnalise.slug}`} class="card card-largo">
          <span class="card-tag">{dataPorExtenso(ultimaAnalise)}</span>
          <span class="card-titulo">{ultimaAnalise.titulo}</span>
          <span class="card-desc">{ultimaAnalise.descricao}</span>
        </a>
      </section>
    )}

    <section class="rodape-home">
      <p>
        Sou professor na Escola SESI de Poços de Caldas e trabalho com dados
        educacionais na Secretaria Municipal de Educação. <a href="/sobre">Mais sobre mim</a>.
      </p>
      <p>
        Professor que quiser usar este material na própria escola:
        <a href="/para-professores">comece por aqui</a>.
      </p>
    </section>
  </main>
</Layout>

<style>
  main {
    max-width: 680px;
    margin: 0 auto;
    padding: 4rem 1.5rem;
    animation: fade-up 0.5s ease both;
  }

  @keyframes fade-up {
    from { opacity: 0; transform: translateY(12px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  /* --- capa --- */
  .capa { margin-bottom: 3.5rem; }

  h1 {
    font-family: var(--font-display);
    font-size: clamp(2.4rem, 6vw, 3.4rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.1;
    margin-bottom: 0.5rem;
  }

  .papeis { font-size: 0.95rem; font-weight: 300; color: var(--muted); }
  .sep { margin: 0 0.4rem; opacity: 0.5; }

  .linha {
    margin-top: 1.25rem;
    font-size: 1rem;
    font-weight: 300;
    line-height: 1.75;
    opacity: 0.85;
    max-width: 34rem;
  }

  .acoes { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 1.75rem; }

  .btn {
    display: inline-block;
    padding: 0.6rem 1.15rem;
    border: 1px solid var(--accent);
    border-radius: 4px;
    background: var(--accent);
    color: var(--bg);
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    text-decoration: none;
    transition: opacity 0.2s ease;
  }

  .btn:hover { opacity: 0.85; }

  .btn.sec { background: transparent; color: var(--accent); }
  .btn.sec:hover { background: var(--accent); color: var(--bg); opacity: 1; }

  /* --- blocos --- */
  .bloco { margin-bottom: 3rem; }

  .bloco-topo {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    padding-bottom: 0.6rem;
    margin-bottom: 1.25rem;
    border-bottom: 1px solid var(--rule);
  }

  h2 {
    font-family: var(--font-display);
    font-size: 1.4rem;
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  .mais {
    font-size: 0.78rem;
    font-weight: 400;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: var(--accent);
    text-decoration: none;
    white-space: nowrap;
  }

  .mais:hover { text-decoration: underline; text-underline-offset: 3px; }

  /* --- publicados recentemente --- */
  .recentes { list-style: none; }

  .recentes li + li { border-top: 1px solid var(--rule); }

  .recentes a {
    display: flex;
    gap: 1.1rem;
    padding: 0.85rem 0;
    text-decoration: none;
    color: inherit;
  }

  .recentes a:hover .titulo { color: var(--accent); }

  .data {
    flex: 0 0 4rem;
    font-size: 0.75rem;
    font-weight: 400;
    color: var(--muted);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    font-variant-numeric: tabular-nums;
    padding-top: 0.15rem;
  }

  .corpo { display: flex; flex-direction: column; gap: 0.2rem; }

  .titulo { font-size: 0.95rem; font-weight: 500; line-height: 1.4; transition: color 0.2s ease; }

  .meta { font-size: 0.78rem; font-weight: 300; color: var(--muted); }

  .tag-online {
    display: inline-block;
    margin-left: 0.5rem;
    padding: 0.05rem 0.45rem;
    border: 1px solid var(--accent);
    border-radius: 99px;
    font-size: 0.68rem;
    letter-spacing: 0.03em;
    color: var(--accent);
  }

  /* --- cartões --- */
  .vitrine { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; }

  .card {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding: 1.25rem 1.35rem;
    border: 1px solid var(--rule);
    border-radius: 4px;
    background: white;
    text-decoration: none;
    color: inherit;
    transition: border-color 0.2s ease, transform 0.2s ease;
  }

  .card:hover { border-color: var(--accent); transform: translateY(-2px); }

  .card-tag {
    font-size: 0.68rem;
    font-weight: 400;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .card-titulo { font-family: var(--font-display); font-size: 1.05rem; font-weight: 700; line-height: 1.25; }

  .card-desc {
    font-size: 0.82rem;
    font-weight: 300;
    line-height: 1.55;
    color: var(--muted);
    display: -webkit-box;
    -webkit-line-clamp: 4;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card-largo .card-desc { -webkit-line-clamp: 3; }

  /* --- rodapé da home --- */
  .rodape-home {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--rule);
    font-size: 0.9rem;
    font-weight: 300;
    line-height: 1.7;
    color: var(--muted);
  }

  .rodape-home a { color: var(--accent); text-decoration: underline; text-underline-offset: 2px; }

  @media (max-width: 640px) {
    main { padding: 2.5rem 1.25rem; }
    .vitrine { grid-template-columns: 1fr; }
    .card-desc { -webkit-line-clamp: 3; }
  }

  @media (prefers-reduced-motion: reduce) {
    main { animation: none; }
    .card:hover { transform: none; }
  }
</style>
