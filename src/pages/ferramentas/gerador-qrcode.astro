  .qr-root .reset:hover{color:var(--destaque);border-color:var(--destaque)}
  .qr-root .primary{
    background:var(--destaque);border:1px solid var(--destaque);color:#fff;
    box-shadow:0 8px 20px -12px var(--destaque)
  }
  .qr-root .primary:hover:not(:disabled){filter:brightness(1.06)}
  .qr-root .primary:disabled, .qr-root .ghost:disabled{opacity:.45;cursor:not-allowed;box-shadow:none}
