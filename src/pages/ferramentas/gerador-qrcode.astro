  .qr-root .chips{display:flex;flex-wrap:wrap;gap:7px}
  .qr-root .chip.com-icone{display:inline-flex;align-items:center;gap:8px;padding-left:9px}
  .qr-root .chip.com-icone img{width:16px;height:16px;border-radius:3.5px;display:block}

  .qr-root .toggle{
    display:inline-flex;align-items:center;gap:8px;font-size:13px;color:var(--muted);
    border:1px solid var(--rule-c);border-radius:999px;padding:7px 14px;cursor:pointer;
    user-select:none;transition:.16s;margin-top:4px
  }
  .qr-root .toggle:hover{color:var(--ink)}
  .qr-root .toggle input{accent-color:var(--accent);width:15px;height:15px;cursor:pointer}
  .qr-root .toggle.on{color:var(--ink);border-color:var(--muted)}

  /* ----- teoria ----- */
  .qr-root .theory{
    margin-top:34px;border-top:1px solid var(--rule-c);padding-top:24px;max-width:74ch
  }
  .qr-root .theory h2{font-family:var(--font-display);font-weight:600;font-size:24px;margin:0 0 12px}
  .qr-root .theory p{color:var(--muted);font-size:15px;margin:0 0 12px;line-height:1.7}
  .qr-root .theory b{color:var(--ink);font-weight:600}
  .qr-root .theory ul{margin:0 0 12px;padding-left:20px;color:var(--muted);font-size:15px}
  .qr-root .theory li{margin-bottom:6px}
  .qr-root .theory .nota-final{
    font-size:13px;border-top:1px solid var(--rule-c);padding-top:14px;margin-top:18px
  }
  .qr-root .theory .marca{display:block;margin-top:5px;font-size:12px;opacity:.75}

  @media (prefers-reduced-motion:reduce){.qr-root *{transition:none!important}}
</style>

<script>
// @ts-nocheck — JS vanilla da ferramenta; sem tipagem TS
import qrcode from 'qrcode-generator';

// A biblioteca converte texto em bytes truncando cada caractere em 8 bits
// (latin-1), o que quebraria acentos e emoji. No modo byte, o que os leitores
// esperam é UTF-8 — então trocamos o conversor antes de qualquer codificação.
qrcode.stringToBytes = (s) => Array.from(new TextEncoder().encode(s));

/* ---------- estado ---------- */
const PADRAO = 'https://yuritobias.com/ferramentas';

const estado = {
  texto: PADRAO,
  nivel: 'M',            // escolha do usuário; com logo, o efetivo vira 'H'
  margem: 4,
  modulos: 'quadrado',
  olhos: 'quadrado',
  frente: '#1C1917',
  fundo: '#FFFFFF',
  transparente: false,
  logo: null,            // data URL (PNG) da imagem já redimensionada
  logoAspecto: 1,        // largura / altura
  logoTamanho: 0.20,     // fração do lado do código
  respiro: true,
};

// Reserva de correção de cada nível, em fração dos módulos (aproximada — a
// norma define a reserva por codeword, não por módulo).
const RESERVA = { L: 0.07, M: 0.15, Q: 0.25, H: 0.30 };

/* ---------- elementos ---------- */
const $ = (id) => document.getElementById(id);

const elPreview   = $('preview');
const elErro      = $('erro');
const elCaption   = $('caption');
const elConteudo  = $('conteudo');
const elDicaUrl   = $('dica-url');
const elBtnHttps  = $('btn-https');
const elDropzone  = $('dropzone');
const elLogoInput = $('logo-input');
const elDzVazio   = $('dz-vazio');
const elDzCheio   = $('dz-cheio');
const elLogoThumb = $('logo-thumb');
const elLogoNome  = $('logo-nome');
const elBtnRemover= $('btn-remover-logo');
const elLogoCtrl  = $('logo-controles');
const elLogoTam   = $('logo-tam');
const elLogoTamV  = $('logo-tam-val');
const elRespiro   = $('respiro');
const elLblResp   = $('lbl-respiro');
const elMedFill   = $('medidor-fill');
const elMedTxt    = $('medidor-txt');
const elCorFrente = $('cor-frente');
const elCorFundo  = $('cor-fundo');
const elTransp    = $('transparente');
const elLblTransp = $('lbl-transparente');
const elAvisoCor  = $('aviso-contraste');
const elNivelNota = $('nivel-nota');
const elMargem    = $('margem');
const elMargemV   = $('margem-val');
const elDlPng     = $('dl-png');
const elDlSvg     = $('dl-svg');
const elPngTam    = $('png-tam');

/* ---------- utilidades ---------- */
const f = (v) => Math.round(v * 1000) / 1000;

const esc = (s) => String(s).replace(/[&<>"]/g, (c) => (
  { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]
));

function luminancia(hex) {
  const c = hex.replace('#', '');
  const canais = [0, 2, 4]
    .map((i) => parseInt(c.slice(i, i + 2), 16) / 255)
    .map((x) => (x <= 0.03928 ? x / 12.92 : Math.pow((x + 0.055) / 1.055, 2.4)));
  return 0.2126 * canais[0] + 0.7152 * canais[1] + 0.0722 * canais[2];
}

function contraste(a, b) {
  const la = luminancia(a);
  const lb = luminancia(b);
  return (Math.max(la, lb) + 0.05) / (Math.min(la, lb) + 0.05);
}

function nomeArquivo(ext) {
  let base = 'qrcode';
  try {
    base = 'qrcode-' + new URL(estado.texto).hostname.replace(/^www\./, '');
  } catch { /* não é URL: fica o nome genérico */ }
  return base.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '') + '.' + ext;
}

/* ---------- geometria da imagem central ---------- */
// Caixa da imagem e do respiro, em módulos, já posicionadas na malha.
function caixaLogo(n) {
  const lado = estado.logoTamanho * n;
  const a = estado.logoAspecto || 1;
  const largura = a >= 1 ? lado : lado * a;
  const altura  = a >= 1 ? lado / a : lado;
  const folga   = estado.respiro ? Math.max(0.6, lado * 0.09) : 0;
  const centro  = estado.margem + n / 2;
  return {
    imgX: centro - largura / 2,
    imgY: centro - altura / 2,
    imgL: largura,
    imgA: altura,
    padX: centro - largura / 2 - folga,
    padY: centro - altura / 2 - folga,
    padL: largura + 2 * folga,
    padA: altura + 2 * folga,
  };
}

// Quantos módulos ficam sob a imagem (contando pelo centro de cada módulo).
function modulosCobertos(n, cx) {
  let cobertos = 0;
  for (let r = 0; r < n; r++) {
    const y = estado.margem + r + 0.5;
    if (y < cx.padY || y > cx.padY + cx.padA) continue;
    for (let c = 0; c < n; c++) {
      const x = estado.margem + c + 0.5;
      if (x >= cx.padX && x <= cx.padX + cx.padL) cobertos++;
    }
  }
  return cobertos;
}

/* ---------- montagem do SVG ---------- */
// Devolve o SVG como string: é ela que vai para a tela, para o arquivo .svg
// e para o rasterizador do PNG — assim os três resultados são idênticos.
function montarSvg(qr, opcoes = {}) {
  const n = qr.getModuleCount();
  const m = estado.margem;
  const total = n + 2 * m;
  const ehOlho = (r, c) =>
    (r < 7 && c < 7) || (r < 7 && c >= n - 7) || (r >= n - 7 && c < 7);

  const partes = [];

  if (!estado.transparente) {
    partes.push(`<rect width="${total}" height="${total}" fill="${estado.fundo}"/>`);
  }

  /* módulos de dados */
  if (estado.modulos === 'quadrado') {
    // Um único path: quadrados vizinhos se fundem sem costura entre eles.
    let d = '';
    for (let r = 0; r < n; r++) {
      for (let c = 0; c < n; c++) {
        if (!qr.isDark(r, c) || ehOlho(r, c)) continue;
        d += `M${m + c} ${m + r}h1v1h-1z`;
      }
    }
    if (d) partes.push(`<path d="${d}" fill="${estado.frente}"/>`);
  } else {
    const formas = [];
    for (let r = 0; r < n; r++) {
      for (let c = 0; c < n; c++) {
        if (!qr.isDark(r, c) || ehOlho(r, c)) continue;
        formas.push(estado.modulos === 'ponto'
          ? `<circle cx="${m + c + 0.5}" cy="${m + r + 0.5}" r="0.45"/>`
          : `<rect x="${m + c}" y="${m + r}" width="1" height="1" rx="0.3"/>`);
      }
    }
    if (formas.length) partes.push(`<g fill="${estado.frente}">${formas.join('')}</g>`);
  }

  /* cantos de referência */
  const olhos = [[0, 0], [0, n - 7], [n - 7, 0]];
  for (const [r, c] of olhos) {
    const x = m + c;
    const y = m + r;
    if (estado.olhos === 'circular') {
      partes.push(
        `<circle cx="${x + 3.5}" cy="${y + 3.5}" r="3" fill="none" stroke="${estado.frente}" stroke-width="1"/>` +
        `<circle cx="${x + 3.5}" cy="${y + 3.5}" r="1.5" fill="${estado.frente}"/>`
      );
    } else {
      const rExt = estado.olhos === 'arredondado' ? 1.8 : 0;
      const rInt = estado.olhos === 'arredondado' ? 0.75 : 0;
      partes.push(
        `<rect x="${x + 0.5}" y="${y + 0.5}" width="6" height="6" rx="${rExt}" fill="none" stroke="${estado.frente}" stroke-width="1"/>` +
        `<rect x="${x + 2}" y="${y + 2}" width="3" height="3" rx="${rInt}" fill="${estado.frente}"/>`
      );
    }
  }

  /* imagem no centro */
  if (estado.logo) {
    const cx = caixaLogo(n);
    if (estado.respiro) {
      // Sobre fundo transparente o respiro precisa de uma cor própria, senão
      // os módulos apareceriam atrás de uma imagem com transparência.
      const corPad = estado.transparente ? '#FFFFFF' : estado.fundo;
      partes.push(
        `<rect x="${f(cx.padX)}" y="${f(cx.padY)}" width="${f(cx.padL)}" height="${f(cx.padA)}" ` +
        `rx="${f(Math.min(cx.padL, cx.padA) * 0.16)}" fill="${corPad}"/>`
      );
    }
    partes.push(
      `<image href="${estado.logo}" xlink:href="${estado.logo}" ` +
      `x="${f(cx.imgX)}" y="${f(cx.imgY)}" width="${f(cx.imgL)}" height="${f(cx.imgA)}" ` +
      `preserveAspectRatio="xMidYMid meet"/>`
    );
  }

  const dim = opcoes.px ? ` width="${opcoes.px}" height="${opcoes.px}"` : '';
  const titulo = `<title>QR code: ${esc(estado.texto.slice(0, 120))}</title>`;
  // Só quadrados: crispEdges alinha as bordas ao pixel e evita a franja cinza
  // entre módulos vizinhos. Com curvas ele desliga o antisserrilhado e o
  // resultado fica escadeado — nesse caso vale a renderização normal.
  const nitidez = (estado.modulos === 'quadrado' && estado.olhos === 'quadrado')
    ? ' shape-rendering="crispEdges"'
    : '';

  return `<svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" ` +
    `viewBox="0 0 ${total} ${total}"${dim}${nitidez} role="img">` +
    titulo + partes.join('') + `</svg>`;
}

/* ---------- render ---------- */
let qrAtual = null;

function render() {
  const texto = estado.texto.trim();

  // dica do https:// — endereço sem esquema é lido como texto puro
  const pareceDominio = /^[a-z0-9][a-z0-9.-]*\.[a-z]{2,}(\/|$)/i.test(texto) && !/\s/.test(texto);
  elDicaUrl.hidden = !pareceDominio;

  if (!texto) {
    qrAtual = null;
    elPreview.className = 'preview vazio';
    elPreview.textContent = 'Cole um link ou escreva um texto para ver o código.';
    elCaption.textContent = '';
    elErro.hidden = true;
    elDlPng.disabled = true;
    elDlSvg.disabled = true;
    atualizarMedidor(null);
    return;
  }

  const nivel = estado.logo ? 'H' : estado.nivel;
  let qr;
  try {
    qr = qrcode(0, nivel);
    qr.addData(texto, 'Byte');
    qr.make();
  } catch {
    qrAtual = null;
    elPreview.className = 'preview vazio';
    elPreview.textContent = 'Conteúdo longo demais.';
    elCaption.textContent = '';
    elErro.hidden = false;
    elErro.textContent =
      'Esse texto não cabe num QR code (o limite é cerca de 1.200 caracteres no nível H, ' +
      'e menos ainda com acentos). Use um link curto no lugar do texto inteiro.';
    elDlPng.disabled = true;
    elDlSvg.disabled = true;
    atualizarMedidor(null);
    return;
  }

  qrAtual = qr;
  elErro.hidden = true;
  elPreview.className = 'preview' + (estado.transparente ? ' xadrez' : '');
  elPreview.innerHTML = montarSvg(qr);
  // O texto do usuário fica fora do markup gerado; entra aqui, já como dado.
  const svg = elPreview.querySelector('svg');
  if (svg) svg.setAttribute('aria-label', 'QR code de: ' + texto);

  const n = qr.getModuleCount();
  const versao = (n - 17) / 4;
  const bytes = new TextEncoder().encode(texto).length;
  elCaption.textContent =
    `Versão ${versao} · ${n} × ${n} módulos · correção ${nivel} · ${bytes} bytes`;

  elDlPng.disabled = false;
  elDlSvg.disabled = false;
  atualizarMedidor(qr);
  atualizarContraste();
}

function atualizarMedidor(qr) {
  if (!qr || !estado.logo) {
    elMedTxt.textContent = '';
    elMedFill.style.width = '0%';
    return;
  }
  const n = qr.getModuleCount();
  const cobertos = modulosCobertos(n, caixaLogo(n));
  const fracao = cobertos / (n * n);
  const reserva = RESERVA.H;
  const usado = fracao / reserva;

  elMedFill.style.width = Math.min(100, usado * 100).toFixed(1) + '%';
  elMedFill.className = usado > 0.75 ? 'risco' : usado > 0.5 ? 'atencao' : '';

  const pct = (fracao * 100).toFixed(1).replace('.', ',');
  const situacao = usado > 0.75
    ? 'Sobra pouca folga para dobra, sujeira ou impressão ruim — teste com o celular antes de usar.'
    : usado > 0.5
      ? 'Ainda dentro do limite, mas com menos reserva para imperfeições na impressão.'
      : 'Folga confortável para desgaste, reflexo e impressão.';
  elMedTxt.innerHTML =
    `A imagem cobre <b>${pct}%</b> dos módulos, de uma reserva de cerca de 30% no nível H. ${situacao}`;
}

function atualizarContraste() {
  const razao = contraste(estado.frente, estado.fundo);
  const invertido = luminancia(estado.frente) > luminancia(estado.fundo);

  if (estado.transparente) {
    elAvisoCor.hidden = false;
    elAvisoCor.textContent =
      'Com fundo transparente, o código depende da superfície onde for aplicado — ' +
      'sobre cor escura ou foto, a leitura falha. Use só sobre fundo claro e liso.';
    return;
  }
  if (invertido) {
    elAvisoCor.hidden = false;
    elAvisoCor.textContent =
      'Código invertido (módulos claros sobre fundo escuro). Alguns leitores resolvem, ' +
      'muitos não. O esperado é escuro sobre claro.';
    return;
  }
  if (razao < 4) {
    elAvisoCor.hidden = false;
    elAvisoCor.textContent =
      `Contraste baixo (${razao.toFixed(1).replace('.', ',')}:1). Escureça os módulos ou clareie ` +
      'o fundo — abaixo de 4:1 a leitura começa a falhar com pouca luz.';
    return;
  }
  elAvisoCor.hidden = true;
}

/* ---------- imagem central ---------- */
function carregarLogo(arquivo, opcoes = {}) {
  if (!arquivo) return;
  if (!arquivo.type.startsWith('image/')) {
    alertaLogo('Escolha um arquivo de imagem (PNG, JPG, WebP ou SVG).');
    return;
  }

  const leitor = new FileReader();
  leitor.onerror = () => alertaLogo('Não foi possível ler esse arquivo.');
  leitor.onload = () => {
    const img = new Image();
    img.onerror = () => alertaLogo('Não foi possível abrir essa imagem.');
    img.onload = () => {
      // Tudo é redesenhado como PNG de no máximo 512px: uniformiza os formatos
      // (inclusive SVG), mantém os arquivos exportados leves e garante que o
      // PNG final possa ser gerado — um SVG aninhado nem sempre rasteriza.
      const MAX = 512;
      const lo = img.naturalWidth || img.width || MAX;
      const la = img.naturalHeight || img.height || MAX;
      const escala = Math.min(1, MAX / Math.max(lo, la));
      const w = Math.max(1, Math.round(lo * escala));
      const h = Math.max(1, Math.round(la * escala));

      const cv = document.createElement('canvas');
      cv.width = w;
      cv.height = h;
      const ctx = cv.getContext('2d');
      if (opcoes.arredondar && ctx.roundRect) {
        // Mesmo raio do favicon.svg (6 de 32): é a silhueta da marca. Sem ele,
        // um bloco quadrado no meio do código parece defeito, não logo.
        ctx.beginPath();
        ctx.roundRect(0, 0, w, h, Math.min(w, h) * 0.1875);
        ctx.clip();
      }
      ctx.drawImage(img, 0, 0, w, h);

      estado.logo = cv.toDataURL('image/png');
      estado.logoAspecto = w / h;

      elLogoThumb.src = estado.logo;
      elLogoNome.textContent = opcoes.nome || arquivo.name;
      elDzVazio.hidden = true;
      elDzCheio.hidden = false;
      elBtnRemover.hidden = false;
      elLogoCtrl.hidden = false;
      travarNivel(true);
      render();
    };
    img.src = leitor.result;
  };
  leitor.readAsDataURL(arquivo);
}

// Atalho para o uso próprio: a marca do site, sem passar pelo seletor de arquivo.
async function usarLogoDoSite() {
  try {
    const resp = await fetch('/icon-512.png');
    if (!resp.ok) throw new Error(String(resp.status));
    const blob = await resp.blob();
    // Zera o seletor para que reescolher o mesmo arquivo depois ainda dispare o change.
    elLogoInput.value = '';
    carregarLogo(
      new File([blob], 'logo-yuritobias.png', { type: blob.type || 'image/png' }),
      { arredondar: true, nome: 'Logo do site' }
    );
  } catch {
    alertaLogo('Não foi possível carregar a logo do site. Sem conexão, envie o arquivo pelo seletor.');
  }
}

function alertaLogo(msg) {
  elErro.hidden = false;
  elErro.textContent = msg;
}

function removerLogo() {
  estado.logo = null;
  estado.logoAspecto = 1;
  elLogoInput.value = '';
  elLogoThumb.removeAttribute('src');
  elDzVazio.hidden = false;
  elDzCheio.hidden = true;
  elBtnRemover.hidden = true;
  elLogoCtrl.hidden = true;
  travarNivel(false);
  render();
}

// Com imagem no centro o nível vai para H e os outros ficam indisponíveis.
function travarNivel(travado) {
  elNivelNota.hidden = !travado;
  document.querySelectorAll('#grupo-nivel .chip').forEach((b) => {
    b.disabled = travado;
    b.setAttribute('aria-pressed', String(
      travado ? b.dataset.val === 'H' : b.dataset.val === estado.nivel
    ));
  });
}

/* ---------- downloads ---------- */
function baixar(blob, nome, formato) {
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url;
  a.download = nome;
  // Âncora solta de propósito: o clique não sobe até o rastreador de PDFs do
  // Layout, que registraria o UUID do blob. O evento certo é contado abaixo.
  a.click();
  setTimeout(() => URL.revokeObjectURL(url), 2000);

  if (window.goatcounter && window.goatcounter.count) {
    window.goatcounter.count({
      path: 'qrcode-download-' + formato,
      title: 'Gerador de QR Code: download ' + formato.toUpperCase(),
      event: true,
    });
  }
}

function baixarSvg() {
  if (!qrAtual) return;
  // O viewBox já garante a escala livre; a dimensão explícita só evita que o
  // arquivo abra no tamanho padrão de 150px em editores como Inkscape.
  const svg = montarSvg(qrAtual, { px: 1024 });
  baixar(new Blob([svg], { type: 'image/svg+xml;charset=utf-8' }), nomeArquivo('svg'), 'svg');
}

function baixarPng() {
  if (!qrAtual) return;
  const px = parseInt(elPngTam.value, 10);
  const svg = montarSvg(qrAtual, { px });

  const img = new Image();
  img.onerror = () => alertaLogo('Não foi possível gerar o PNG. Tente baixar o SVG.');
  img.onload = () => {
    const cv = document.createElement('canvas');
    cv.width = px;
    cv.height = px;
    cv.getContext('2d').drawImage(img, 0, 0, px, px);
    cv.toBlob((blob) => {
      if (blob) baixar(blob, nomeArquivo('png'), 'png');
    }, 'image/png');
  };
  // Data URI (e não blob:) para o canvas não ficar marcado como contaminado.
  img.src = 'data:image/svg+xml;charset=utf-8,' + encodeURIComponent(svg);
}

/* ---------- ligações ---------- */
function grupoChips(idGrupo, aoEscolher) {
  const grupo = $(idGrupo);
  grupo.addEventListener('click', (e) => {
    const btn = e.target.closest('.chip');
    if (!btn || btn.disabled) return;
    grupo.querySelectorAll('.chip').forEach((b) => {
      b.setAttribute('aria-pressed', String(b === btn));
    });
    aoEscolher(btn.dataset.val);
    render();
  });
}

elConteudo.value = PADRAO;
elConteudo.addEventListener('input', () => {
  estado.texto = elConteudo.value;
  render();
});

elBtnHttps.addEventListener('click', () => {
  elConteudo.value = 'https://' + elConteudo.value.trim();
  estado.texto = elConteudo.value;
  elConteudo.focus();
  render();
});

elDropzone.addEventListener('click', () => elLogoInput.click());
elDropzone.addEventListener('keydown', (e) => {
  if (e.key === 'Enter' || e.key === ' ') {
    e.preventDefault();
    elLogoInput.click();
  }
});
elLogoInput.addEventListener('change', (e) => carregarLogo(e.target.files[0]));

['dragenter', 'dragover'].forEach((ev) =>
  elDropzone.addEventListener(ev, (e) => {
    e.preventDefault();
    elDropzone.classList.add('arrastando');
  })
);
['dragleave', 'drop'].forEach((ev) =>
  elDropzone.addEventListener(ev, (e) => {
    e.preventDefault();
    elDropzone.classList.remove('arrastando');
  })
);
elDropzone.addEventListener('drop', (e) => {
  const arquivo = e.dataTransfer && e.dataTransfer.files[0];
  if (arquivo) carregarLogo(arquivo);
});

$('btn-logo-site').addEventListener('click', usarLogoDoSite);
elBtnRemover.addEventListener('click', removerLogo);

elLogoTam.addEventListener('input', () => {
  estado.logoTamanho = Number(elLogoTam.value) / 100;
  elLogoTamV.textContent = elLogoTam.value + '%';
  render();
});

elRespiro.addEventListener('change', () => {
  estado.respiro = elRespiro.checked;
  elLblResp.classList.toggle('on', elRespiro.checked);
  render();
});

elCorFrente.addEventListener('input', () => {
  estado.frente = elCorFrente.value.toUpperCase();
  render();
});
elCorFundo.addEventListener('input', () => {
  estado.fundo = elCorFundo.value.toUpperCase();
  render();
});

$('presets').addEventListener('click', (e) => {
  const btn = e.target.closest('.swatch');
  if (!btn) return;
  estado.frente = btn.dataset.frente;
  estado.fundo = btn.dataset.fundo;
  elCorFrente.value = estado.frente;
  elCorFundo.value = estado.fundo;
  if (estado.transparente) {
    estado.transparente = false;
    elTransp.checked = false;
    elLblTransp.classList.remove('on');
  }
  render();
});

elTransp.addEventListener('change', () => {
  estado.transparente = elTransp.checked;
  elLblTransp.classList.toggle('on', elTransp.checked);
  render();
});

elMargem.addEventListener('input', () => {
  estado.margem = Number(elMargem.value);
  elMargemV.textContent = estado.margem === 1 ? '1 módulo' : estado.margem + ' módulos';
  render();
});

grupoChips('grupo-modulos', (v) => { estado.modulos = v; });
grupoChips('grupo-olhos',   (v) => { estado.olhos = v; });
grupoChips('grupo-nivel',   (v) => { estado.nivel = v; });

elDlPng.addEventListener('click', baixarPng);
elDlSvg.addEventListener('click', baixarSvg);

render();
</script>
