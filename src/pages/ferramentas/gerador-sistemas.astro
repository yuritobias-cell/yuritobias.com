  tipos: ['s2'], naturezas: ['inteira'], casos: ['spd'], metodo: 'adicao',
  layout: 'compacta', gabTipo: 'compacto',
  qtd: 8, versoes: 1, agrupar: false, grafica: true,
  escola: '', titulo: 'Sistemas de equações do 1º grau',
  instrucao: 'Resolva e classifique cada sistema, apresentando os cálculos.',
