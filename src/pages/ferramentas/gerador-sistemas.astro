    instrucao: $('instrucao').value.trim(),
    ident: $('ident').checked,
    temGab: $('temGab').checked,
    gabTipo: ctl.gabTipo.ler(),
  };
}

function viaveisDe(cfg) {
  return cfg.tipos.map((k) => ({
    k, nome: FAMILIAS[k].nome, gerar: FAMILIAS[k].gerar,
    nats:  FAMILIAS[k].nats.filter((n) => cfg.naturezas.includes(n)),
    casos: FAMILIAS[k].casos.filter((c) => cfg.casos.includes(c)),
  }));
}

function gerar() {
  const cfg = lerConfig();
  const todas = viaveisDe(cfg);
  const viaveis = todas.filter((f) => f.nats.length && f.casos.length);
  const fora = todas.filter((f) => !f.nats.length || !f.casos.length);
  const aviso = $('aviso');

  if (!viaveis.length) {
    listas = [];
    aviso.hidden = false;
    aviso.textContent = 'Nenhum tipo marcado produz questões com o que está selecionado. '
      + 'Problemas contextualizados são sempre possíveis e determinados, e de solução inteira — '
      + 'para SPI, SI ou solução racional, marque um dos sistemas.';
    $('saida').innerHTML = '';
    $('resumo').textContent = '';
    return;
  }
  if (fora.length) {
    aviso.hidden = false;
    aviso.textContent = `Fora da lista: ${fora.map((f) => f.nome).join(', ')} — `
      + 'não existe questão desse tipo com a solução e a classificação marcadas.';
  } else {
    aviso.hidden = true;
  }

  const gerarDe = (f) => f.gerar(
    pesado(f.nats.map((n) => [n, PESO_NAT[n]])),
    pesado(f.casos.map((c) => [c, PESO_CASO[c]])),
    cfg);

  listas = [];
  for (let i = 0; i < cfg.versoes; i++) listas.push(montaLista(viaveis, cfg.qtd, cfg.agrupar, gerarDe));
  pintar();
}

function pintar() {
  const cfg = lerConfig();
  if (!listas.length) return;
  $('saida').innerHTML = montaFolhas(listas, cfg, () => '');
  const nomes = viaveisDe(cfg).filter((f) => f.nats.length && f.casos.length).map((f) => f.nome);
  $('resumo').textContent = resumo(listas[0].length, listas.length, cfg.temGab, nomes);
}

/* --- ligações dos controles ----------------------------------------------- */
['qtd', 'versoes', 'agrupar'].forEach((id) => $(id).addEventListener('change', gerar));
['grafica'].forEach((id) => $(id).addEventListener('change', gerar));
['escola', 'titulo', 'instrucao'].forEach((id) => $(id).addEventListener('input', pintar));
['ident', 'temGab'].forEach((id) => $(id).addEventListener('change', pintar));

$('gerar').addEventListener('click', gerar);
$('imprimir').addEventListener('click', () => window.print());
$('restaurar').addEventListener('click', () => {
  Object.entries(ctl).forEach(([campo, c]) => c.repor(PADRAO[campo]));
  ['qtd', 'versoes', 'escola', 'titulo', 'instrucao'].forEach((id) => { $(id).value = PADRAO[id]; });
  ['agrupar', 'ident', 'temGab', 'grafica'].forEach((id) => { $(id).checked = PADRAO[id]; });
  gerar();
});

gerar();
</script>
