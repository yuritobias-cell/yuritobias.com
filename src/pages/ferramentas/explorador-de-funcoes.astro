---
import Layout from '../../layouts/Layout.astro';
import '../../styles/matematica.css';
---

<Layout
  title="Explorador de Funções"
  description="Mexa nos coeficientes a, b e c e veja a reta ou a parábola responder na hora — com raízes, vértice, discriminante e imagem em valores exatos, com fração e radical."
>
  <div class="ef-root">
    <header class="masthead">
      <p class="eyebrow"><a href="/ferramentas">Ferramentas</a> · <a href="/ferramentas?tipo=simulacoes">Simulações</a> · Funções</p>
      <h1>Explorador de <em>funções</em></h1>
      <p class="lede">Puxe os coeficientes e veja o gráfico responder. O que muda quando
      <em>a</em> troca de sinal? E quando <em>c</em> sobe? Deixe o <em>rastro</em> ligado para
      comparar as curvas. As raízes, o vértice e o discriminante saem <em>exatos</em> —
      com fração e radical, e não com o decimal arredondado.</p>
    </header>

    <div class="tabs" role="tablist" aria-label="Tipo de função" id="tabs">
      <button class="tab" role="tab" data-t="afim">1º grau · <i>ax</i> + <i>b</i></button>
      <button class="tab" role="tab" data-t="quad">2º grau · <i>ax</i>² + <i>bx</i> + <i>c</i></button>
    </div>

    <div class="stage">
      <div class="canvas-card">
        <svg class="board" id="board" viewBox="0 0 560 560" aria-label="Plano cartesiano com o gráfico da função"></svg>
      </div>

      <div class="painel">
        <div class="card card-lei">
          <div class="rotulo">A função</div>
          <div class="lei mat" id="lei"></div>
        </div>

        <div class="card">
          <div class="rotulo">Coeficientes</div>
          <div class="sliders" id="sliders">
            <label class="sl" data-k="a">
              <span class="k mat"><i>a</i></span>
              <input type="range" id="sa" min="-10" max="10" step="0.5" value="1" />
              <output id="oa">1</output>
            </label>
            <label class="sl" data-k="b">
              <span class="k mat"><i>b</i></span>
              <input type="range" id="sb" min="-10" max="10" step="0.5" value="0" />
              <output id="ob">0</output>
            </label>
            <label class="sl" data-k="c">
              <span class="k mat"><i>c</i></span>
              <input type="range" id="sc" min="-10" max="10" step="0.5" value="-4" />
              <output id="oc">−4</output>
            </label>
          </div>
          <p class="aviso" id="aviso" hidden></p>
        </div>

        <div class="card">
          <div class="rotulo">O que o gráfico diz</div>
          <dl class="props" id="props"></dl>
        </div>

        <div class="controles">
          <label class="toggle on"><input type="checkbox" id="tRaizes" checked> Raízes</label>
          <label class="toggle on" id="lbVertice"><input type="checkbox" id="tVertice" checked> Vértice</label>
          <label class="toggle"><input type="checkbox" id="tRastro"> Rastro</label>
          <div class="zoom" role="group" aria-label="Escala do eixo y" id="zoom">
            <button type="button" class="z" data-z="5">±5</button>
            <button type="button" class="z" data-z="10">±10</button>
            <button type="button" class="z" data-z="25">±25</button>
            <button type="button" class="z" data-z="50">±50</button>
          </div>
          <button class="btn" type="button" id="limpar">Limpar rastro</button>
          <button class="btn" type="button" id="restaurar">Restaurar</button>
        </div>
      </div>
    </div>
  </div>
</Layout>

<style is:global>
  /* ============================================================
     Ferramenta: Explorador de Funções.
     Escopado sob .ef-root. A fração e o radical vêm de
     src/styles/matematica.css, a mesma folha das geradoras — o
     htmlNum() de matematica.js devolve exatamente essa marcação.
     ============================================================ */
  .ef-root{
    --bg:#F8F6F1; --ink:#1C1917; --muted:#78716C; --accent:#1B4F4F; --rule:#E2DDD6;
    --papel:#FFFFFF; --grade:#EFEBE3; --grade-forte:#DFD9CF;
    --curva:#1B4F4F;
    --raiz:#B4531F;
    --vertice:#6E5B9B;
    --font-display:'Playfair Display',Georgia,serif;
    --font-body:'IBM Plex Sans',system-ui,sans-serif;
    --font-mono:ui-monospace,SFMono-Regular,Menlo,monospace;
    --radius:14px;

    font-family:var(--font-body); line-height:1.5; color:var(--ink);
    max-width:1180px; margin:0 auto; padding:30px 22px 56px;
    -webkit-font-smoothing:antialiased;
  }
  .ef-root, .ef-root *{box-sizing:border-box}

  .ef-root header.masthead{margin-bottom:22px}
  .ef-root .eyebrow{font-family:var(--font-mono);font-size:11.5px;letter-spacing:.18em;
    text-transform:uppercase;color:var(--accent);margin:0 0 8px}
  .ef-root .eyebrow a{color:inherit;text-decoration:none;border-bottom:1px solid transparent}
  .ef-root .eyebrow a:hover{border-bottom-color:currentColor}
  .ef-root h1{font-family:var(--font-display);font-weight:700;
    font-size:clamp(30px,5vw,46px);line-height:1.06;margin:0;letter-spacing:-.01em}
  .ef-root h1 em{font-style:italic;font-weight:400;color:var(--accent)}
  .ef-root .lede{color:var(--muted);max-width:64ch;margin:12px 0 0;font-size:15px}
  .ef-root .lede em{font-style:italic;color:var(--ink);font-weight:500}

  .ef-root .tabs{display:flex;flex-wrap:wrap;gap:8px;margin:26px 0 18px}
  .ef-root .tab{appearance:none;border:1px solid var(--rule);background:transparent;
    color:var(--muted);font-family:var(--font-body);font-weight:500;font-size:13px;
    padding:9px 16px;border-radius:999px;cursor:pointer;transition:.18s}
  .ef-root .tab i{font-family:Georgia,serif;font-style:italic}
  .ef-root .tab:hover{color:var(--ink);border-color:var(--muted)}
  .ef-root .tab[aria-selected="true"]{background:var(--accent);border-color:var(--accent);color:#fff}

  .ef-root .stage{display:grid;grid-template-columns:1.05fr .95fr;gap:22px;align-items:start}
  @media (max-width:900px){.ef-root .stage{grid-template-columns:1fr}}

  .ef-root .canvas-card,.ef-root .card{background:var(--papel);border:1px solid var(--rule);
    border-radius:var(--radius)}
  .ef-root .canvas-card{padding:10px}
  .ef-root svg.board{display:block;width:100%;height:auto}

  .ef-root .painel{display:flex;flex-direction:column;gap:16px}
  .ef-root .card{padding:16px 18px}
  .ef-root .rotulo{font-family:var(--font-mono);font-size:10.5px;letter-spacing:.16em;
    text-transform:uppercase;color:var(--muted);margin-bottom:10px}

  .ef-root .lei{font-size:22px;color:var(--ink);line-height:1.5}

  /* ----- sliders ----- */
  .ef-root .sliders{display:grid;gap:12px}
  .ef-root .sl{display:grid;grid-template-columns:1.6rem 1fr 3rem;align-items:center;gap:12px}
  .ef-root .sl .k{font-size:19px;color:var(--accent)}
  .ef-root .sl output{font-family:var(--font-mono);font-size:13px;text-align:right;
    font-variant-numeric:tabular-nums;color:var(--ink)}
  .ef-root .sl.oculto{display:none}
  .ef-root input[type=range]{width:100%;accent-color:var(--accent);cursor:pointer}
  .ef-root .aviso{margin:12px 0 0;font-size:13px;color:#A6402F;line-height:1.5}

  /* ----- propriedades ----- */
  .ef-root .props{margin:0;display:grid;gap:9px}
  .ef-root .props .linha{display:grid;grid-template-columns:8.2rem 1fr;gap:10px;align-items:baseline}
  .ef-root .props dt{font-size:13px;color:var(--muted)}
  .ef-root .props dd{margin:0;font-family:Georgia,'Times New Roman',serif;font-size:16px;color:var(--ink)}
  .ef-root .props dd.txt{font-family:var(--font-body);font-size:13.5px}

  .ef-root .controles{display:flex;flex-wrap:wrap;gap:8px;align-items:center}
  .ef-root .toggle[hidden]{display:none}
  .ef-root .toggle{display:flex;align-items:center;gap:7px;font-size:12.5px;color:var(--muted);
    border:1px solid var(--rule);background:var(--papel);border-radius:999px;padding:7px 13px;cursor:pointer}
  .ef-root .toggle.on{color:var(--accent);border-color:var(--accent)}
  .ef-root .btn{appearance:none;border:1px solid var(--rule);background:var(--papel);
    color:var(--accent);font:inherit;font-size:12.5px;border-radius:999px;padding:7px 14px;cursor:pointer}
  .ef-root .btn:hover{border-color:var(--accent)}
  .ef-root .zoom{display:flex;border:1px solid var(--rule);border-radius:999px;overflow:hidden;background:var(--papel)}
  .ef-root .z{appearance:none;border:0;background:transparent;font:inherit;font-size:12px;
    color:var(--muted);padding:7px 11px;cursor:pointer}
  .ef-root .z[aria-pressed="true"]{background:var(--accent);color:#fff}

  /* ----- plano ----- */
  .ef-root .g-1{stroke:var(--grade);stroke-width:1}
  .ef-root .g-5{stroke:var(--grade-forte);stroke-width:1}
  .ef-root .g-eixo{stroke:var(--muted);stroke-width:1.3}
  .ef-root .g-rot{font-family:var(--font-mono);font-size:10px;fill:var(--muted)}
  .ef-root .curva{fill:none;stroke:var(--curva);stroke-width:3;stroke-linecap:round}
  .ef-root .rastro{fill:none;stroke:var(--curva);stroke-width:2;opacity:.16}
  .ef-root .eixo-sim{stroke:var(--vertice);stroke-width:1;stroke-dasharray:4 4;opacity:.8}
  .ef-root .pt-raiz{fill:var(--raiz)}
  .ef-root .pt-vert{fill:var(--vertice)}
  .ef-root .pt-rot{font-family:var(--font-mono);font-size:11px}
  .ef-root .pt-rot.r{fill:var(--raiz)}
  .ef-root .pt-rot.v{fill:var(--vertice)}

  @media print{
    body > nav, body > footer{display:none !important}
    .ef-root .tabs,.ef-root .controles,.ef-root .lede,.ef-root .sliders .k{display:none !important}
    .ef-root .stage{grid-template-columns:1fr 1fr}
    .ef-root *{-webkit-print-color-adjust:exact;print-color-adjust:exact}
  }
</style>

<script>
// @ts-nocheck — JS vanilla da ferramenta; sem tipagem TS

/* Aritmética exata e tipografia da matemática: os mesmos utilitários das
   geradoras de lista. É o que permite dizer que a raiz é (3 − √17)/2, e não
   −0,5616. */
import {
  MENOS, rac, rSoma, rSub, rMul, rDiv, rNeg, rVal, rZero, rInt, rIgual,
  htmlRac, htmlNum, numVal, raizQuadratica, simplificaRadical, quadradoPerfeito,
} from '../../utils/matematica.js';

const $ = (id) => document.getElementById(id);
const NS = 'http://www.w3.org/2000/svg';
const board = $('board');

/* ---------- estado ---------- */
const PADRAO = { tipo: 'quad', a: 1, b: 0, c: -4, zoom: 10 };
const est = { ...PADRAO };
const mostrar = { raizes: true, vertice: true, rastro: false };
let rastro = [];                 // caminhos das curvas anteriores

/* ---------- plano ---------- */
const M = 44, W = 560 - 2 * M, H = 560 - 2 * M;
const XMIN = -10, XMAX = 10;
const px = (x) => M + ((x - XMIN) / (XMAX - XMIN)) * W;
const py = (y) => M + ((est.zoom - y) / (2 * est.zoom)) * H;

const el = (tag, attrs) => {
  const n = document.createElementNS(NS, tag);
  for (const k in attrs) n.setAttribute(k, attrs[k]);
  return n;
};

/* ---------- coeficientes como racionais exatos ----------
   Os controles andam de meio em meio, então todo coeficiente é n/2 — e a conta
   inteira acontece em racionais, sem ponto flutuante. */
const racDe = (v) => rac(Math.round(v * 2), 2);

/* Para as raízes, a equação é multiplicada pelo denominador comum: as raízes
   não mudam, e raizQuadratica() precisa de coeficientes inteiros. */
function inteiros(a, b, c) {
  const k = a.d * b.d * c.d;
  return [a.n * (k / a.d), b.n * (k / b.d), c.n * (k / c.d)];
}

const txt = (r) => htmlRac(r);

/* ---------- a lei da função, escrita ---------- */
function termo(coef, corpo, primeiro) {
  if (rZero(coef)) return '';
  const neg = coef.n < 0;
  const abs = { n: Math.abs(coef.n), d: coef.d };
  const um = rIgual(abs, rac(1)) && corpo !== '';
  const sinal = primeiro ? (neg ? MENOS : '') : (neg ? ` ${MENOS} ` : ' + ');
  return sinal + (um ? '' : htmlRac(abs)) + corpo;
}

function leiHtml(a, b, c) {
  const x = '<i>x</i>';
  const partes = est.tipo === 'quad'
    ? [[a, `${x}<sup>2</sup>`], [b, x], [c, '']]
    : [[a, x], [b, '']];
  let s = '', primeiro = true;
  for (const [co, corpo] of partes) {
    const t = termo(co, corpo, primeiro);
    if (t) { s += t; primeiro = false; }
  }
  return `<i>f</i>(${x}) = ${s || '0'}`;
}

/* ---------- propriedades exatas ---------- */
function propsAfim(a, b) {
  const linhas = [];
  if (rZero(a)) {
    linhas.push(['Tipo', 'Função constante — a reta é horizontal', true]);
    linhas.push(['Raiz', rZero(b) ? 'todo x real' : 'não tem', true]);
  } else {
    const raiz = rDiv(rNeg(b), a);
    linhas.push(['Raiz (zero)', `<i>x</i> = ${txt(raiz)}`, false]);
    linhas.push(['Crescimento', a.n > 0 ? 'crescente — <i>a</i> > 0' : 'decrescente — <i>a</i> < 0', true]);
  }
  linhas.push(['Corta o eixo <i>y</i>', `(0, ${txt(b)})`, false]);
  return linhas;
}

function propsQuad(a, b, c) {
  const linhas = [];
  // Δ = b² − 4ac, exato
  const delta = rSub(rMul(b, b), rMul(rac(4), rMul(a, c)));
  const dv = rVal(delta);

  linhas.push(['Concavidade', a.n > 0 ? 'para cima — <i>a</i> > 0' : 'para baixo — <i>a</i> < 0', true]);
  linhas.push(['Discriminante', `Δ = ${txt(delta)}`, false]);

  // vértice: xv = −b/2a e yv = f(xv) — os dois sempre racionais
  const xv = rDiv(rNeg(b), rMul(rac(2), a));
  const yv = rSoma(rSoma(rMul(a, rMul(xv, xv)), rMul(b, xv)), c);
  linhas.push(['Vértice', `(${txt(xv)}, ${txt(yv)})`, false]);
  linhas.push(['Eixo de simetria', `<i>x</i> = ${txt(xv)}`, false]);
  linhas.push(['Imagem', a.n > 0
    ? `<i>y</i> ≥ ${txt(yv)}`
    : `<i>y</i> ≤ ${txt(yv)}`, false]);

  if (dv < 0) {
    linhas.push(['Raízes', 'Δ &lt; 0 — não corta o eixo <i>x</i>', true]);
  } else {
    const [A, B, C] = inteiros(a, b, c);
    const D = B * B - 4 * A * C;
    if (D === 0) {
      linhas.push(['Raiz (dupla)', `<i>x</i> = ${htmlNum(raizQuadratica(A, B, 0, 1))}`, false]);
    } else {
      const r1 = raizQuadratica(A, B, D, -1);
      const r2 = raizQuadratica(A, B, D, 1);
      const [menor, maior] = numVal(r1) <= numVal(r2) ? [r1, r2] : [r2, r1];
      linhas.push(['Raízes', `${htmlNum(menor)} e ${htmlNum(maior)}`, false]);
      if (!quadradoPerfeito(D)) {
        const { d } = simplificaRadical(D);
        linhas.push(['', `Δ não é quadrado perfeito: as raízes são irracionais (√${d}).`, true]);
      }
    }
  }
  linhas.push(['Corta o eixo <i>y</i>', `(0, ${txt(c)})`, false]);
  return linhas;
}

/* ---------- desenho do plano ---------- */
function desenhaPlano(svg) {
  const Z = est.zoom;
  const passo = Z <= 5 ? 1 : Z <= 10 ? 1 : Z <= 25 ? 5 : 10;
  const forte = Z <= 10 ? 5 : Z <= 25 ? 10 : 50;

  for (let x = XMIN; x <= XMAX; x++) {
    svg.appendChild(el('line', { class: x % 5 === 0 ? 'g-5' : 'g-1', x1: px(x), y1: M, x2: px(x), y2: M + H }));
  }
  for (let y = -Z; y <= Z; y += passo) {
    svg.appendChild(el('line', { class: y % forte === 0 ? 'g-5' : 'g-1', x1: M, y1: py(y), x2: M + W, y2: py(y) }));
  }

  svg.appendChild(el('line', { class: 'g-eixo', x1: M, y1: py(0), x2: M + W, y2: py(0) }));
  svg.appendChild(el('line', { class: 'g-eixo', x1: px(0), y1: M, x2: px(0), y2: M + H }));

  for (let x = XMIN; x <= XMAX; x += 5) {
    if (x === 0) continue;
    const t = el('text', { class: 'g-rot', x: px(x), y: py(0) + 14, 'text-anchor': 'middle' });
    t.textContent = String(x).replace('-', MENOS);
    svg.appendChild(t);
  }
  for (let y = -Z; y <= Z; y += forte) {
    if (y === 0) continue;
    const t = el('text', { class: 'g-rot', x: px(0) - 7, y: py(y) + 4, 'text-anchor': 'end' });
    t.textContent = String(y).replace('-', MENOS);
    svg.appendChild(t);
  }
}

/* Caminho da curva, cortado quando sai muito da área visível. */
function caminho(f) {
  const Z = est.zoom;
  let d = '', quebrou = true;
  const passos = 480;
  for (let i = 0; i <= passos; i++) {
    const x = XMIN + (i / passos) * (XMAX - XMIN);
    const y = f(x);
    if (!Number.isFinite(y) || y < -Z * 2.5 || y > Z * 2.5) { quebrou = true; continue; }
    d += `${quebrou ? 'M' : 'L'} ${px(x).toFixed(1)} ${py(y).toFixed(1)} `;
    quebrou = false;
  }
  return d;
}

/* ---------- render ---------- */
function render() {
  const a = racDe(est.a), b = racDe(est.b), c = racDe(est.c);
  const av = rVal(a), bv = rVal(b), cv = rVal(c);
  const quad = est.tipo === 'quad';

  $('lei').innerHTML = leiHtml(a, b, quad ? c : null);

  const aviso = $('aviso');
  if (quad && av === 0) {
    aviso.hidden = false;
    aviso.innerHTML = 'Com <b>a = 0</b> o termo do 2º grau some e o que sobra é uma função do '
      + '1º grau — a parábola vira reta. É o caso que a definição exclui.';
  } else {
    aviso.hidden = true;
  }

  const f = quad ? (x) => av * x * x + bv * x + cv : (x) => av * x + bv;

  const svg = board;
  svg.innerHTML = '';
  desenhaPlano(svg);

  for (const d of rastro) svg.appendChild(el('path', { class: 'rastro', d }));

  const d = caminho(f);
  svg.appendChild(el('path', { class: 'curva', d }));

  // pontos notáveis
  const dentro = (x, y) => x >= XMIN && x <= XMAX && y >= -est.zoom && y <= est.zoom;

  if (quad && av !== 0) {
    const xv = rDiv(rNeg(b), rMul(rac(2), a));
    const yv = rSoma(rSoma(rMul(a, rMul(xv, xv)), rMul(b, xv)), c);
    const xvv = rVal(xv), yvv = rVal(yv);
    if (mostrar.vertice && dentro(xvv, yvv)) {
      svg.appendChild(el('line', { class: 'eixo-sim', x1: px(xvv), y1: M, x2: px(xvv), y2: M + H }));
      svg.appendChild(el('circle', { class: 'pt-vert', cx: px(xvv), cy: py(yvv), r: 5.5 }));
      const t = el('text', { class: 'pt-rot v', x: px(xvv) + 9, y: py(yvv) + (av > 0 ? 16 : -8) });
      t.textContent = `V(${fmt(xvv)}, ${fmt(yvv)})`;
      svg.appendChild(t);
    }
    if (mostrar.raizes) {
      const D = bv * bv - 4 * av * cv;
      if (D >= 0) {
        for (const sg of [-1, 1]) {
          const x = (-bv + sg * Math.sqrt(D)) / (2 * av);
          if (!dentro(x, 0)) continue;
          svg.appendChild(el('circle', { class: 'pt-raiz', cx: px(x), cy: py(0), r: 5 }));
          const t = el('text', { class: 'pt-rot r', x: px(x), y: py(0) - 10, 'text-anchor': 'middle' });
          t.textContent = fmt(x);
          svg.appendChild(t);
          if (D === 0) break;
        }
      }
    }
  } else if (!quad && av !== 0 && mostrar.raizes) {
    const x = -bv / av;
    if (dentro(x, 0)) {
      svg.appendChild(el('circle', { class: 'pt-raiz', cx: px(x), cy: py(0), r: 5 }));
      const t = el('text', { class: 'pt-rot r', x: px(x), y: py(0) - 10, 'text-anchor': 'middle' });
      t.textContent = fmt(x);
      svg.appendChild(t);
    }
  }

  // propriedades
  const linhas = quad && av !== 0 ? propsQuad(a, b, c) : propsAfim(quad ? b : a, quad ? c : b);
  $('props').innerHTML = linhas.map(([dt, dd, plano]) =>
    `<div class="linha"><dt>${dt}</dt><dd class="${plano ? 'txt' : ''}">${dd}</dd></div>`).join('');
}

/* Decimal curto para o rótulo dentro do gráfico (o valor exato está no painel). */
function fmt(v) {
  const r = Math.round(v * 100) / 100;
  return String(r).replace('-', MENOS).replace('.', ',');
}

/* ---------- controles ---------- */
function guardaRastro() {
  if (!mostrar.rastro) return;
  const atual = board.querySelector('.curva');
  if (!atual) return;
  rastro.push(atual.getAttribute('d'));
  if (rastro.length > 6) rastro.shift();
}

for (const k of ['a', 'b', 'c']) {
  const inp = $('s' + k);
  inp.addEventListener('input', () => {
    guardaRastro();
    est[k] = parseFloat(inp.value);
    $('o' + k).textContent = String(est[k]).replace('-', MENOS).replace('.', ',');
    render();
  });
}

document.querySelectorAll('.tab').forEach((b) => {
  b.addEventListener('click', () => {
    est.tipo = b.dataset.t;
    document.querySelectorAll('.tab').forEach((x) => x.setAttribute('aria-selected', String(x === b)));
    // No 1º grau só existem dois coeficientes: a reta é ax + b.
    document.querySelector('.sl[data-k="c"]').classList.toggle('oculto', est.tipo === 'afim');
    $('lbVertice').hidden = est.tipo === 'afim';
    rastro = [];
    render();
  });
});

function liga(id, chave) {
  const cb = $(id);
  cb.addEventListener('change', () => {
    mostrar[chave] = cb.checked;
    cb.closest('.toggle').classList.toggle('on', cb.checked);
    if (chave === 'rastro' && !cb.checked) rastro = [];
    render();
  });
}
liga('tRaizes', 'raizes');
liga('tVertice', 'vertice');
liga('tRastro', 'rastro');

document.querySelectorAll('.z').forEach((b) => {
  b.addEventListener('click', () => {
    est.zoom = Number(b.dataset.z);
    document.querySelectorAll('.z').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
    rastro = [];
    render();
  });
});

$('limpar').addEventListener('click', () => { rastro = []; render(); });
$('restaurar').addEventListener('click', () => {
  Object.assign(est, PADRAO);
  rastro = [];
  for (const k of ['a', 'b', 'c']) {
    $('s' + k).value = est[k];
    $('o' + k).textContent = String(est[k]).replace('-', MENOS).replace('.', ',');
  }
  document.querySelectorAll('.tab').forEach((x) => x.setAttribute('aria-selected', String(x.dataset.t === est.tipo)));
  document.querySelector('.sl[data-k="c"]').classList.toggle('oculto', est.tipo === 'afim');
  $('lbVertice').hidden = est.tipo === 'afim';
  document.querySelectorAll('.z').forEach((x) => x.setAttribute('aria-pressed', String(Number(x.dataset.z) === est.zoom)));
  render();
});

/* ---------- início ---------- */
document.querySelector('.tab[data-t="quad"]').setAttribute('aria-selected', 'true');
document.querySelector('.z[data-z="10"]').setAttribute('aria-pressed', 'true');
render();
</script>
