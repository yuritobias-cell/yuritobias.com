---
import Layout from '../../layouts/Layout.astro';
---

<Layout
  title="Sorteador de Grupos"
  description="Distribua os alunos da turma em grupos aleatórios: escolha o tamanho de cada grupo ou o número de grupos, sorteie e copie o resultado. A lista fica salva no seu navegador."
>

  <!-- IBM Plex Mono carregado só nesta página (rótulos e contagens usam mono).
       Playfair Display + IBM Plex Sans já vêm do Layout. -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet" />

  <div class="srt-root">

    <header class="masthead">
      <p class="eyebrow"><a href="/ferramentas">Ferramentas</a> · <a href="/ferramentas?tipo=suporte">Suporte</a> · Sala de aula</p>
      <h1>Sorteador de <em>grupos</em></h1>
      <p class="lede">Cole a lista da turma — um nome por linha — e decida se você quer fixar o
      <em>tamanho</em> de cada grupo ou o <em>número</em> de grupos. O sorteio distribui os nomes
      da forma mais equilibrada possível: quando a divisão não é exata, a diferença é sempre de
      um aluno. A lista fica guardada no seu navegador, então recarregar a página não perde a
      turma — e nada é enviado para lugar nenhum.</p>
    </header>

    <!-- ================= CONTROLES ================= -->
    <section class="card">
      <div class="campo">
        <label class="card-label" for="names">Lista de alunos (um por linha)</label>
        <textarea id="names" rows="6" spellcheck="false"
          placeholder="Ana Lima&#10;Bruno Souza&#10;Carla Mendes&#10;Daniel Costa&#10;..."></textarea>
      </div>

      <div class="row">
        <div class="field">
          <label class="card-label" for="mode">Modo</label>
          <select id="mode">
            <option value="per_group">Alunos por grupo</option>
            <option value="num_groups">Número de grupos</option>
          </select>
        </div>
        <div class="field">
          <label class="card-label" for="qty" id="qty-label">Alunos por grupo</label>
          <input type="number" id="qty" value="4" min="1" max="99" />
        </div>
        <div class="field acao">
          <button class="primary" id="btn-sortear" type="button">Sortear grupos</button>
        </div>
      </div>

      <p id="error-box" class="error" role="alert"></p>
    </section>

    <!-- ================= RESULTADO ================= -->
    <section id="results-section" aria-live="polite">
      <div class="info-bar">
        <p class="stat" id="stat-text"></p>
        <div class="info-actions">
          <button class="ghost" id="btn-copy" type="button">Copiar grupos</button>
          <button class="ghost" id="btn-resortear" type="button">Sortear novamente</button>
        </div>
      </div>
      <div class="groups-grid" id="groups-grid"></div>
    </section>

  </div>
</Layout>

<style is:global>
  /* ============================================================
     Ferramenta: Sorteador de Grupos
     CSS escopado sob .srt-root para não vazar para o resto do site.
     is:global (e não scoped) porque os cards de grupo são criados
     por JavaScript e não carregam o atributo data-astro-cid.
     ============================================================ */

  .srt-root {
    --bg:     #F8F6F1;
    --ink:    #1C1917;
    --accent: #1B4F4F;
    --muted:  #78716C;
    --rule:   #E2DDD6;
    --paper:  #FFFFFF;

    --font-display: 'Playfair Display', Georgia, serif;
    --font-body:    'IBM Plex Sans', system-ui, sans-serif;
    --font-mono:    'IBM Plex Mono', ui-monospace, monospace;

    color: var(--ink);
    font-family: var(--font-body);
    line-height: 1.55;
    max-width: 820px;
    margin: 0 auto;
    padding: 2.5rem 1.25rem 4rem;
  }
  .srt-root, .srt-root * { box-sizing: border-box; }

  /* ---------- masthead ---------- */
  .srt-root .masthead {
    border-bottom: 1px solid var(--rule);
    padding-bottom: 1.5rem;
    margin-bottom: 2rem;
  }
  .srt-root .eyebrow {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
    margin: 0 0 0.5rem;
  }
  .srt-root .eyebrow a { color: inherit; text-decoration: none; border-bottom: 1px solid transparent; }
  .srt-root .eyebrow a:hover { border-bottom-color: currentColor; }
  .srt-root .masthead h1 {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.9rem, 5vw, 2.6rem);
    line-height: 1.08;
    letter-spacing: -0.01em;
    margin: 0 0 0.6rem;
  }
  .srt-root .masthead h1 em { font-style: italic; font-weight: 400; color: var(--accent); }
  .srt-root .lede {
    color: var(--muted);
    max-width: 62ch;
    margin: 0;
    font-size: 0.95rem;
  }
  .srt-root .lede em { font-style: normal; color: var(--ink); }

  /* ---------- card de controles ---------- */
  .srt-root .card {
    background: var(--paper);
    border: 1px solid var(--rule);
    border-radius: 14px;
    padding: 18px;
    margin-bottom: 1.75rem;
  }
  .srt-root .card-label {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 9px;
    display: block;
  }
  .srt-root .campo { margin-bottom: 16px; }

  .srt-root textarea {
    width: 100%;
    resize: vertical;
    font-family: var(--font-body);
    font-size: 14px;
    line-height: 1.7;
    color: var(--ink);
    background: var(--bg);
    border: 1px solid var(--rule);
    border-radius: 10px;
    padding: 10px 12px;
  }
  .srt-root textarea::placeholder { color: #A8A29E; }

  .srt-root .row { display: flex; gap: 14px; align-items: flex-end; flex-wrap: wrap; }
  .srt-root .field { display: flex; flex-direction: column; }
  .srt-root .field.acao { margin-left: auto; }

  .srt-root select,
  .srt-root input[type="number"] {
    font-family: var(--font-body);
    font-size: 14px;
    color: var(--ink);
    background: var(--bg);
    border: 1px solid var(--rule);
    border-radius: 10px;
    padding: 9px 12px;
  }
  .srt-root select { min-width: 11rem; }
  .srt-root input[type="number"] { width: 6rem; font-family: var(--font-mono); }

  .srt-root textarea:focus-visible,
  .srt-root select:focus-visible,
  .srt-root input:focus-visible,
  .srt-root button:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 1px;
  }

  /* ---------- botões ---------- */
  .srt-root .primary, .srt-root .ghost {
    appearance: none;
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 500;
    border-radius: 999px;
    padding: 10px 18px;
    cursor: pointer;
    transition: 0.16s;
  }
  .srt-root .primary {
    background: var(--accent);
    border: 1px solid var(--accent);
    color: #fff;
    box-shadow: 0 8px 20px -12px var(--accent);
  }
  .srt-root .primary:hover { filter: brightness(1.12); }
  .srt-root .ghost {
    background: transparent;
    color: var(--muted);
    border: 1px solid var(--rule);
  }
  .srt-root .ghost:hover { color: var(--ink); border-color: var(--muted); }

  /* ---------- erro ---------- */
  .srt-root .error {
    display: none;
    font-size: 13px;
    color: #A8442B;
    background: color-mix(in srgb, #A8442B 8%, var(--bg));
    border: 1px solid color-mix(in srgb, #A8442B 30%, var(--bg));
    border-radius: 10px;
    padding: 9px 12px;
    margin: 16px 0 0;
  }
  .srt-root .error.on { display: block; }

  /* ---------- resultado ---------- */
  .srt-root #results-section { display: none; }
  .srt-root #results-section.on { display: block; }

  .srt-root .info-bar {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 10px;
    padding-bottom: 0.9rem;
    margin-bottom: 1.25rem;
    border-bottom: 1px solid var(--rule);
  }
  .srt-root .info-actions { display: flex; gap: 8px; flex-wrap: wrap; }
  .srt-root .stat { margin: 0; font-size: 13px; color: var(--muted); }
  .srt-root .stat b { font-family: var(--font-mono); font-weight: 600; color: var(--ink); }

  .srt-root .groups-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(190px, 1fr));
    gap: 12px;
  }

  .srt-root .group-card {
    background: var(--paper);
    border: 1px solid var(--rule);
    border-top: 3px solid var(--c);
    border-radius: 12px;
    padding: 14px 16px;
    animation: srt-fade-up 0.25s ease both;
  }
  @keyframes srt-fade-up {
    from { opacity: 0; transform: translateY(8px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  .srt-root .group-header {
    display: flex;
    align-items: center;
    gap: 9px;
    margin-bottom: 11px;
    padding-bottom: 9px;
    border-bottom: 1px solid var(--rule);
  }
  .srt-root .group-badge {
    width: 22px;
    height: 22px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    color: var(--c);
    background: color-mix(in srgb, var(--c) 13%, var(--bg));
  }
  .srt-root .group-title {
    font-family: var(--font-display);
    font-size: 15px;
    font-weight: 600;
  }
  .srt-root .group-count {
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--muted);
  }
  .srt-root .student-list { list-style: none; margin: 0; padding: 0; }
  .srt-root .student-item {
    font-size: 13.5px;
    color: var(--ink);
    padding: 3px 0;
    line-height: 1.45;
    display: flex;
    align-items: baseline;
    gap: 8px;
  }
  .srt-root .dot {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--c);
    opacity: 0.55;
    flex-shrink: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .srt-root .group-card { animation: none; }
  }

  @media (max-width: 560px) {
    .srt-root .field.acao { margin-left: 0; width: 100%; }
    .srt-root .primary { width: 100%; }
  }
</style>

<script>
  // @ts-nocheck — JS vanilla da ferramenta; sem tipagem TS

  // Uma cor por grupo, na paleta terrosa do site. O tom entra como --c no card
  // e o CSS deriva dele o fundo do badge (color-mix), a borda e o marcador.
  const CORES = [
    '#1B4F4F', // teal (accent)
    '#936614', // ocre
    '#A8442B', // terracota
    '#3C5A3C', // verde-oliva
    '#4C4470', // ardósia
    '#7A3B52', // vinho
    '#2C5474', // azul-petróleo
    '#6B5A2E', // bronze
  ];

  const $ = (id) => document.getElementById(id);

  // Persistência: a lista da turma e as opções sobrevivem ao recarregar a página
  const STORE_KEY = 'sorteador:estado';
  try {
    const salvo = JSON.parse(localStorage.getItem(STORE_KEY));
    if (salvo) {
      $('names').value = salvo.nomes ?? '';
      $('mode').value = salvo.modo ?? 'per_group';
      $('qty').value = salvo.qtd ?? 4;
    }
  } catch { /* estado corrompido: ignora e segue com os padrões */ }

  function persistir() {
    localStorage.setItem(STORE_KEY, JSON.stringify({
      nomes: $('names').value,
      modo: $('mode').value,
      qtd: $('qty').value,
    }));
  }
  $('names').addEventListener('input', persistir);
  $('qty').addEventListener('input', persistir);

  function atualizarLabelModo() {
    $('qty-label').textContent =
      $('mode').value === 'per_group' ? 'Alunos por grupo' : 'Número de grupos';
  }
  $('mode').addEventListener('change', () => {
    atualizarLabelModo();
    persistir();
  });
  atualizarLabelModo();

  function shuffle(arr) {
    const a = [...arr];
    for (let i = a.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [a[i], a[j]] = [a[j], a[i]];
    }
    return a;
  }

  function erro(msg) {
    const box = $('error-box');
    box.textContent = msg;
    box.classList.add('on');
  }

  // Copiar grupos como texto (para colar no WhatsApp da turma)
  let ultimosGrupos = [];
  $('btn-copy').addEventListener('click', async function () {
    if (ultimosGrupos.length === 0) return;
    const texto = ultimosGrupos
      .map((g, i) => `Grupo ${i + 1}: ${g.join(', ')}`)
      .join('\n');
    try {
      await navigator.clipboard.writeText(texto);
      this.textContent = 'Copiado ✓';
    } catch {
      this.textContent = 'Não foi possível copiar';
    }
    setTimeout(() => { this.textContent = 'Copiar grupos'; }, 1800);
  });

  function sortear() {
    const raw = $('names').value;
    const qty = parseInt($('qty').value, 10);
    const mode = $('mode').value;
    const grid = $('groups-grid');
    const section = $('results-section');

    $('error-box').classList.remove('on');
    grid.innerHTML = '';
    section.classList.remove('on');

    const names = raw.split('\n').map((n) => n.trim()).filter((n) => n.length > 0);

    if (names.length < 2) return erro('Adicione pelo menos 2 alunos na lista.');
    if (!qty || qty < 1) return erro('Informe um valor válido (mínimo 1).');

    let numGroups;
    if (mode === 'per_group') {
      if (qty > names.length) return erro(`Você tem apenas ${names.length} alunos. Diminua o tamanho do grupo.`);
      numGroups = Math.ceil(names.length / qty);
    } else {
      if (qty > names.length) return erro(`Não é possível criar ${qty} grupos com apenas ${names.length} alunos.`);
      numGroups = qty;
    }

    const shuffled = shuffle(names);
    const groups = Array.from({ length: numGroups }, () => []);
    shuffled.forEach((name, i) => groups[i % numGroups].push(name));
    ultimosGrupos = groups;

    const sizes = [...new Set(groups.map((g) => g.length))];
    const sizeText = sizes.length === 1 ? `${sizes[0]} alunos` : `${sizes.join(' ou ')} alunos`;
    $('stat-text').innerHTML =
      `<b>${names.length}</b> alunos em <b>${numGroups}</b> grupos · ${sizeText} cada`;

    groups.forEach((group, idx) => {
      const card = document.createElement('div');
      card.className = 'group-card';
      card.style.setProperty('--c', CORES[idx % CORES.length]);
      card.style.animationDelay = idx * 0.05 + 's';
      card.innerHTML = `
        <div class="group-header">
          <span class="group-badge">${idx + 1}</span>
          <span class="group-title">Grupo ${idx + 1}</span>
          <span class="group-count">${group.length}</span>
        </div>
        <ul class="student-list"></ul>
      `;
      const list = card.querySelector('.student-list');
      group.forEach((n) => {
        const li = document.createElement('li');
        li.className = 'student-item';
        const dot = document.createElement('span');
        dot.className = 'dot';
        li.appendChild(dot);
        li.appendChild(document.createTextNode(n));
        list.appendChild(li);
      });
      grid.appendChild(card);
    });

    section.classList.add('on');
    section.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  $('btn-sortear').addEventListener('click', sortear);
  $('btn-resortear').addEventListener('click', sortear);
</script>
